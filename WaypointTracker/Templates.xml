<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <!-- World map pin. The mixin table is filled in MapPins.lua once the
         world map has loaded. The pin's tip sits on the waypoint, so the icon
         is drawn above the frame's centre (the mouse area is moved in Lua). -->
    <Frame name="WaypointTrackerMapPinTemplate" mixin="WaypointTrackerMapPinMixin" virtual="true" hidden="true" enableMouse="true">
        <Size x="22" y="22"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" file="Interface\AddOns\WaypointTracker\Media\Pin">
                    <Size x="22" y="22"/>
                    <Anchors>
                        <Anchor point="BOTTOM" relativePoint="CENTER" y="-1"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Highlight" file="Interface\AddOns\WaypointTracker\Media\Pin" alphaMode="ADD" alpha="0.5">
                    <Size x="22" y="22"/>
                    <Anchors>
                        <Anchor point="BOTTOM" relativePoint="CENTER" y="-1"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>
</Ui>
