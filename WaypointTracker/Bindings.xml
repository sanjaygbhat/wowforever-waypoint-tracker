<Bindings>
    <Binding name="WAYPOINTTRACKER_TOGGLE" header="WAYPOINTTRACKER">
        WaypointTracker_ToggleWindow()
    </Binding>
    <Binding name="WAYPOINTTRACKER_FIND">
        WaypointTracker_ToggleFind()
    </Binding>
    <Binding name="WAYPOINTTRACKER_HERE">
        WaypointTracker_AddHere()
    </Binding>
    <Binding name="WAYPOINTTRACKER_SHARE">
        WaypointTracker_ShareHere()
    </Binding>
    <Binding name="WAYPOINTTRACKER_CLEAR">
        WaypointTracker_ClearActive()
    </Binding>
    <Binding name="WAYPOINTTRACKER_CLOSEST">
        WaypointTracker_SetClosest()
    </Binding>
    <Binding name="WAYPOINTTRACKER_ARROW">
        WaypointTracker_ToggleArrow()
    </Binding>
    <Binding name="WAYPOINTTRACKER_TREASURE">
        WaypointTracker_ToggleTreasure()
    </Binding>
    <Binding name="WAYPOINTTRACKER_ROUTES">
        WaypointTracker_ToggleRoutes()
    </Binding>
    <Binding name="WAYPOINTTRACKER_ROUTE_NEXT">
        WaypointTracker_RouteNext()
    </Binding>
    <Binding name="WAYPOINTTRACKER_ROUTE_RECORD_ADD">
        WaypointTracker_RouteRecordAdd()
    </Binding>
</Bindings>
